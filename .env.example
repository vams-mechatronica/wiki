# Copy to .env for a manual deploy. Jenkins generates .env itself from
# job parameters + Jenkins credentials, so never commit a real .env.
COMPOSE_PROJECT_NAME=docmost
DOCMOST_VERSION=latest
APP_URL=https://wiki.thenearbyshop.com
DOCMOST_BIND=127.0.0.1
# External Docker network shared with the edge nginx
EDGE_NETWORK=webnet
DOCMOST_PORT=3000

# Generate with: openssl rand -hex 32
APP_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

POSTGRES_DB=docmost
POSTGRES_USER=docmost
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# Optional SMTP (needed for invite / password-reset emails)
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Docmost
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
